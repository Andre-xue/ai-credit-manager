{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AI 积分管家主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-exists",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
