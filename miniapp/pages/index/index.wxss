.container { padding-bottom: 40rpx; }
.stats { display: flex; justify-content: space-around; padding: 28rpx 16rpx; }
.stat { text-align: center; flex: 1; }
.stat-num { font-size: 40rpx; font-weight: 650; color: var(--text); line-height: 1.2; }
.stat-label { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 0 20rpx; }
.account .logo { width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22rpx; font-weight: 700; flex-shrink: 0; }
.mask { position: fixed; inset: 0; background: rgba(17,24,39,.5); z-index: 100; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: var(--panel); border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx 60rpx; max-height: 88vh; overflow-y: auto; }
.field-label { font-size: 24rpx; font-weight: 500; color: var(--text); margin: 24rpx 0 12rpx; }
.field-label:first-child { margin-top: 0; }
.input { width: 100%; box-sizing: border-box; padding: 18rpx 20rpx; border: 1rpx solid var(--border); border-radius: 14rpx; font-size: 26rpx; background: #fff; }
.field-row { display: flex; }
.provider-opt { display: flex; align-items: center; padding: 18rpx 12rpx; border-bottom: 1rpx solid var(--border); }
.provider-opt .logo { width: 48rpx; height: 48rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18rpx; font-weight: 700; }
.forecast { margin-top: 16rpx; padding: 12rpx 16rpx; border-radius: 12rpx; font-size: 23rpx; font-weight: 500; }
.forecast.healthy { background: var(--green-soft); color: var(--green); }
.forecast.warning { background: var(--amber-soft); color: var(--amber); }
.forecast.critical { background: var(--red-soft); color: var(--red); }
