.ai-page { min-height: 100vh; background: var(--bg); padding: 60rpx 32rpx 80rpx; box-sizing: border-box; }
.hero { text-align: center; margin: 40rpx 0 70rpx; }
.mark {
  width: 130rpx; height: 130rpx; margin: 0 auto 32rpx; border-radius: 34rpx;
  background: linear-gradient(135deg, #6366f1, #4338ca); color: #fff;
  font-size: 66rpx; line-height: 130rpx; text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(99,102,241,.28);
}
.title { font-size: 42rpx; font-weight: 650; color: var(--text); }
.sub { font-size: 25rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.6; }
.section-label { font-size: 24rpx; color: var(--text-3); margin-bottom: 20rpx; }
.quick-grid { display: flex; flex-direction: column; gap: 18rpx; }
.quick-card {
  background: var(--panel); border: 1rpx solid var(--border); border-radius: 20rpx;
  padding: 28rpx 30rpx; display: flex; align-items: center; gap: 20rpx;
}
.quick-icon { font-size: 38rpx; }
.quick-title { font-size: 27rpx; color: var(--text); }
.notice {
  margin-top: 56rpx; background: var(--primary-soft); border: 1rpx solid #c7d2fe;
  border-radius: 20rpx; padding: 32rpx;
}
.notice-title { font-size: 29rpx; font-weight: 650; color: var(--primary); }
.notice-text { font-size: 25rpx; color: var(--text-2); line-height: 1.7; margin-top: 14rpx; }
.notice-btn {
  margin-top: 24rpx; background: var(--primary); color: #fff; font-size: 26rpx;
  text-align: center; padding: 18rpx; border-radius: 12rpx;
}
